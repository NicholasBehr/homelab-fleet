#!/usr/bin/env bash
set -euo pipefail
runtime_directory=${1:-/run/homelab-backup}
install -d -m 0700 "$runtime_directory"
: > "$runtime_directory/restart"
systemctl stop rclone-import.timer
systemctl stop rclone-import.service
systemctl stop jellyfin.service
systemctl stop tailscale-policy.service
systemctl stop tailscaled.service
for unit in rclone-import.timer rclone-import.service jellyfin tailscale-policy tailscaled; do
  if systemctl is-active --quiet "$unit"; then
    echo "Failed to quiesce $unit for backup" >&2
    exit 1
  fi
done
