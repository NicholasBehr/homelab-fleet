#!/usr/bin/env bash
set -euo pipefail
# A complete staged media tree is required; budget capacity before enabling.
install -d -m 0700 /data/.backup-stage/media /persist/backup/immich-hot /run/homelab-backup
rsync -a --delete /data/immich/ /data/.backup-stage/media/
rsync -a --delete --exclude=/upload --exclude=/library /persist/immich/ /persist/backup/immich-hot/
# Record intent BEFORE stopping: cleanup must also handle partially failed stops.
: > /run/homelab-backup/restart
systemctl stop immich-server.service immich-machine-learning.service
rsync -a --delete /data/immich/ /data/.backup-stage/media/
rsync -a --delete --exclude=/upload --exclude=/library /persist/immich/ /persist/backup/immich-hot/
runuser -u postgres -- pg_dump --format=custom immich > /persist/backup/immich.dump.tmp
mv /persist/backup/immich.dump.tmp /persist/backup/immich.dump
cp /etc/homelab-versions.json /persist/backup/versions.json
# Redis is queue state, not authoritative media/metadata; preserve its on-disk state.
systemctl stop redis-immich.service
rm -rf /persist/backup/redis
cp -a /persist/redis /persist/backup/redis
systemctl start redis-immich.service
systemctl start immich-machine-learning.service immich-server.service
rm /run/homelab-backup/restart
