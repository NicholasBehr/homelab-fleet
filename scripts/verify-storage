#!/usr/bin/env bash
set -euo pipefail
(( $# > 0 && $# % 2 == 0 )) || { echo 'Expected mount/marker pairs' >&2; exit 1; }
while (( $# )); do
  path=$1; marker=$2; shift 2
  mountpoint -q "$path" || { echo "Required mount absent: $path" >&2; exit 1; }
  test "$(findmnt -n -o TARGET -T "$path")" = "$path"
  test "$(findmnt -n -o MAJ:MIN -T "$path")" != "$(findmnt -n -o MAJ:MIN -T /)"
  test "$(cat "$path/.homelab-volume")" = "$marker"
done
