#!/usr/bin/env python3
"""Validate operator-enrolled files without printing their contents."""
import os
from pathlib import Path
import stat
import sys


def verify(path):
    path = Path(path)
    for directory in reversed(path.parents):
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
            raise ValueError("unsafe credential directory ownership or type")
        if stat.S_IMODE(info.st_mode) & 0o022:
            raise ValueError("credential ancestor is writable by another user")
    parent = path.parent.lstat()
    if stat.S_IMODE(parent.st_mode) != 0o700 or parent.st_gid != 0:
        raise ValueError("credential directory must be root:root mode0700")
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0:
            raise ValueError("credential must be a root:root regular file")
        if stat.S_IMODE(info.st_mode) not in (0o400, 0o600):
            raise ValueError("credential must have mode0400 or mode0600")
        if not stream.read(1):
            raise ValueError("credential is empty")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("No runtime credentials declared")
    for filename in sys.argv[1:]:
        try:
            verify(filename)
        except (OSError, ValueError) as error:
            sys.exit(f"Runtime credential rejected: {filename}: {error}")
