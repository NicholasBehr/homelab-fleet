#!/usr/bin/env bash
# Operator-side helper; never connects to or mutates Proxmox.
set -euo pipefail
if test "$#" -ne 2; then
  echo "Usage: scripts/secrets-init CONTAINER_AGE_RECIPIENT RECOVERY_AGE_RECIPIENT" >&2
  exit 2
fi
for recipient in "$@"; do
  [[ "$recipient" =~ ^age1[0-9a-z]+$ ]] || { echo "Invalid public age recipient" >&2; exit 2; }
  printf '' | age -r "$recipient" >/dev/null
done
test ! -e secrets/immich.yaml || { echo "Use sops updatekeys for existing secrets" >&2; exit 1; }
printf 'creation_rules:\n  - path_regex: secrets/immich\\.yaml$\n    age: "%s,%s"\n' "$1" "$2" > .sops.yaml
mkdir -p secrets
printf '%s\n' 'Recipients configured. Run: sops secrets/immich.yaml' 'Required fields: borg-passphrase, borg-ssh-key. Enter values only in the editor.'
