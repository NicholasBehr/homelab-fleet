#!/usr/bin/env bash
set -euo pipefail
stage=${1:-all}
printf 'Check phase: %s\n' "$stage"
case "$stage" in
  lint)
    mapfile -t nix_files < <(git ls-files '*.nix')
    nixfmt --check "${nix_files[@]}"
    shellcheck scripts/check scripts/release-assets scripts/verify-storage scripts/health-check services/immich/secrets-init tests/*.sh services/*/tests/*.sh services/*/backup-* services/*/layout
    python3 -m unittest discover -s tests -p 'test_*.py'
    for directory in services/*/tests; do python3 -m unittest discover -s "$directory" -p 'test_*.py'; done
    python3 tests/secret-scan.py
    ;;
  eval) nix flake check --no-build ;;
  tests)
    bash tests/secrets-roundtrip.sh
    bash tests/borg-restore.sh
    sudo --preserve-env=PATH unshare --mount bash tests/storage-linux.sh
    for script in services/*/tests/*-linux.sh; do sudo --preserve-env=PATH unshare --mount bash "$script"; done
    ;;
  systems)
    mkdir -p .ci-roots
    while IFS= read -r check; do
      nix build --print-build-logs --max-jobs 2 --cores 2 --out-link ".ci-roots/check-$check" ".#checks.x86_64-linux.$check"
    done < <(nix eval --json .#ciPlan.checks | python3 -c 'import json,sys; print("\n".join(sorted(json.load(sys.stdin))))')
    ;;
  image)
    variant=${2:?image output required}
    nix eval --json .#imageCatalog | jq -e --arg name "$variant" 'has($name)' >/dev/null
    mkdir -p .ci-roots
    output=$(nix build --print-build-logs --max-jobs 1 --cores 2 --out-link ".ci-roots/image-$variant" --print-out-paths ".#$variant")
    for archive in "$output"/tarball/*.tar.xz; do
      python3 tests/image-layout.py "$archive"
      du -h "$archive"
    done
    ;;
  selected)
    plan=${2:-.ci-plan.json}
    mkdir -p .ci-roots
    while IFS= read -r check; do
      nix build --print-build-logs --max-jobs 2 --cores 2 --out-link ".ci-roots/check-$check" ".#checks.x86_64-linux.$check"
    done < <(jq -r '.checks[]' "$plan")
    while IFS= read -r variant; do "$0" image "$variant"; done < <(jq -r '.images[]' "$plan")
    ;;
  all)
    "$0" lint; "$0" eval; "$0" tests; "$0" systems
    while IFS= read -r variant; do "$0" image "$variant"; done < <(nix eval --json .#imageCatalog | jq -r 'keys[]')
    ;;
  *) echo 'Usage: scripts/check [all|lint|eval|tests|systems|selected PLAN|image OUTPUT]' >&2; exit 2 ;;
esac
