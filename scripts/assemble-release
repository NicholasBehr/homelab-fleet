#!/usr/bin/env python3
"""Validate exact-run matrix artifacts before assembling one repository release."""
import argparse
import hashlib
import json
from pathlib import Path
import re


def assemble(directory, catalog, commit, version):
    expected = set()
    sums = []
    combined = {}
    for name, entry in catalog.items():
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', name):
            raise ValueError('Unsafe output name')
        archive = name+'-v'+version+'-x86_64-linux.tar.xz'
        manifest_name = name+'-manifest.json'
        checksum_name = name+'-SHA256SUMS'
        expected.update([archive, manifest_name, checksum_name])
        for filename in [archive, manifest_name, checksum_name]:
            path = directory/filename
            if path.is_symlink() or not path.is_file():
                raise ValueError('Missing or unsafe artifact: '+filename)
        manifest = json.loads((directory/manifest_name).read_text())
        required = dict(outputName=name, service=entry['service'], variant=entry['variant'],
                        commit=commit, repositoryVersion=version,
                        architecture='x86_64-linux', archive=archive)
        if any(manifest.get(key) != value for key, value in required.items()):
            raise ValueError('Manifest does not match the exact release: '+name)
        checksums = {}
        for line in (directory/checksum_name).read_text().splitlines():
            digest, separator, filename = line.partition('  ')
            if not separator or not re.fullmatch('[0-9a-f]{64}', digest) or filename in checksums:
                raise ValueError('Invalid checksum file: '+checksum_name)
            checksums[filename] = digest
        if set(checksums) != {archive, manifest_name}:
            raise ValueError('Unexpected checksum paths: '+checksum_name)
        for filename, digest in checksums.items():
            with (directory/filename).open('rb') as stream:
                if hashlib.file_digest(stream, 'sha256').hexdigest() != digest:
                    raise ValueError('Checksum mismatch: '+filename)
        combined.update(checksums)
        sums.append(directory/checksum_name)
    if not expected or {p.name for p in directory.iterdir()} != expected:
        raise ValueError('Missing or unexpected release artifacts')
    # Only after every artifact passes, consolidate per-image checksums.
    content = ''.join(digest+'  '+name+'\n' for name, digest in sorted(combined.items()))
    (directory/'SHA256SUMS').write_text(content)
    for path in sums:
        path.unlink()


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--catalog-json', required=True)
    parser.add_argument('--commit', required=True)
    parser.add_argument('--version', required=True)
    parser.add_argument('--directory', type=Path, default=Path('dist'))
    args = parser.parse_args()
    assemble(args.directory, json.loads(args.catalog_json), args.commit, args.version)
