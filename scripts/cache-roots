#!/usr/bin/env python3
"""Preserve already available outputs using the planner's paths; never evaluate/build."""
import json
from pathlib import Path
import subprocess
import sys

plan = json.loads(Path(sys.argv[1] if len(sys.argv) > 1 else '.ci-plan.json').read_text())
roots = Path('.ci-roots')
roots.mkdir(exist_ok=True)
for kind, outputs in plan['paths'].items():
    for name, output in outputs.items():
        valid = subprocess.run(['nix-store', '--check-validity', output], capture_output=True)
        if valid.returncode == 0:
            link = roots/(kind+'-'+name)
            if link.is_symlink() and str(link.resolve()) == output:
                continue
            if link.is_symlink():
                link.unlink()
            subprocess.run(['nix-store', '--add-root', str(link), '--indirect',
                            '--realise', output], check=True, stdout=subprocess.DEVNULL)
