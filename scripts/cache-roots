#!/usr/bin/env python3
"""Keep already available catalog/check outputs alive during cache GC; never build."""
import json
from pathlib import Path
import subprocess

roots = Path('.ci-roots')
roots.mkdir(exist_ok=True)
for kind, attr in [('image', 'packages.x86_64-linux'), ('check', 'checks.x86_64-linux')]:
    outputs = json.loads(subprocess.check_output(['nix', 'eval', '--json', '.#'+attr,
        '--apply', 'builtins.mapAttrs (_: output: output.outPath)']))
    for name, output in outputs.items():
        valid = subprocess.run(['nix-store', '--check-validity', output], capture_output=True)
        if valid.returncode == 0:
            link = roots/(kind+'-'+name)
            if link.is_symlink() and str(link.resolve()) == output:
                continue
            if link.is_symlink():
                link.unlink()
            subprocess.run(['nix-store', '--add-root', str(roots/(kind+'-'+name)),
                            '--indirect', '--realise', output], check=True, stdout=subprocess.DEVNULL)
