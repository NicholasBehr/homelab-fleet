#!/usr/bin/env bash
# Inside the operational container; require every declared service and a recent backup.
set -euo pipefail
while IFS= read -r volume; do
  verify-storage "$(jq -r .path <<< "$volume")" "$(jq -r .marker <<< "$volume")"
done < <(jq -c '.[]' /etc/homelab-storage.json)
while IFS= read -r path; do df -h "$path"; done < <(jq -r '.[].path' /etc/homelab-storage.json)
health=/etc/homelab-health.json
while IFS= read -r unit; do systemctl is-active --quiet "$unit"; done < <(jq -r '.units[]' "$health")
curl --fail --silent "$(jq -r .url "$health")" >/dev/null
tailscale status --json | jq -e '.BackendState == "Running"'
tailscale serve status
if ! jq -e '.backupEnabled' "$health" >/dev/null; then
  echo 'Backups UNCONFIGURED' >&2; exit 1
fi
name=$(jq -r .backupName "$health")
test "$(systemctl show "borgbackup-job-$name" -p Result --value)" = success
test "$(systemctl show "borgbackup-job-$name" -p ExecMainStatus --value)" = 0
archive_time=$("borg-job-$name" list --last 1 --json | jq -er '.archives[-1].time')
archive_epoch=$(date -d "$archive_time" +%s)
age=$(( $(date +%s) - archive_epoch ))
max_age=$(jq -r .backupMaxAgeSeconds "$health")
(( age >= 0 && age <= max_age )) || { echo 'Backup exceeds configured freshness limit' >&2; exit 1; }
