// Merge into the existing tailnet policy; replace example identities first.
// No CI identity. Review with Tailscale's policy tests before applying.
{
  "groups": {
    "group:homelab-admins": ["admin@example.com"],
    "group:immich-users": ["user@example.com"],
    "group:home-assistant-users": ["home@example.com"],
    "group:nextcloud-users": ["files@example.com"],
    "group:jellyfin-users": ["media@example.com"],
    "group:paperless-ngx-users": ["documents@example.com"],
  },
  "tagOwners": {
    "tag:homelab-host": ["group:homelab-admins"],
    "tag:immich": ["group:homelab-admins"],
    "tag:home-assistant": ["group:homelab-admins"],
    "tag:nextcloud": ["group:homelab-admins"],
    "tag:jellyfin": ["group:homelab-admins"],
    "tag:paperless-ngx": ["group:homelab-admins"],
  },
  "grants": [
    {"src": ["group:nextcloud-users"], "dst": ["tag:nextcloud"], "ip": ["tcp:443"]},
    {"src": ["group:homelab-admins"], "dst": ["tag:homelab-host", "tag:immich", "tag:home-assistant", "tag:nextcloud", "tag:jellyfin", "tag:paperless-ngx"], "ip": ["tcp:22", "tcp:443"]},
    {"src": ["group:immich-users"], "dst": ["tag:immich"], "ip": ["tcp:443"]},
    {"src": ["group:home-assistant-users"], "dst": ["tag:home-assistant"], "ip": ["tcp:443"]},
    {"src": ["group:jellyfin-users"], "dst": ["tag:jellyfin"], "ip": ["tcp:443"]},
    {"src": ["group:paperless-ngx-users"], "dst": ["tag:paperless-ngx"], "ip": ["tcp:443"]},
  ],
  "ssh": [
    {"action": "check", "src": ["group:homelab-admins"], "dst": ["tag:homelab-host", "tag:immich", "tag:home-assistant", "tag:nextcloud", "tag:jellyfin", "tag:paperless-ngx"], "users": ["root"]},
  ],
  "tests": [
    {"src": "files@example.com", "accept": ["tag:nextcloud:443"], "deny": ["tag:nextcloud:22", "tag:immich:443", "tag:home-assistant:443"]},
    {"src": "user@example.com", "accept": ["tag:immich:443"], "deny": ["tag:immich:22", "tag:homelab-host:443"]},
    {"src": "home@example.com", "accept": ["tag:home-assistant:443"], "deny": ["tag:home-assistant:22", "tag:immich:443"]},
    {"src": "media@example.com", "accept": ["tag:jellyfin:443"], "deny": ["tag:jellyfin:22", "tag:immich:443", "tag:home-assistant:443"]},
    {"src": "documents@example.com", "accept": ["tag:paperless-ngx:443"], "deny": ["tag:paperless-ngx:22", "tag:immich:443", "tag:nextcloud:443"]},
  ],
}
